[Unit]
Description=Semantic Router Playground (internal demo)
After=network.target semantic-router-selector.service

[Service]
Type=simple
User=sts
WorkingDirectory=/home/sts/semantic-router
Environment=PLAYGROUND_PORT=8081
Environment=PLAYGROUND_LISTEN_ADDRESS=127.0.0.1:8081
Environment=VLLM_POOL_ENABLED=true
Environment=VLLM_POOL_MOCK_MODE=false
Environment=VLLM_POOL_SERVICE_URL=http://127.0.0.1:8080
Environment=OFFICIAL_VLLM_URL=http://127.0.0.1:8080
Environment=SEMANTIC_ROUTER_TAKEOVER_ENABLED=false
Environment=PLAYGROUND_SCHEDULER_MODE=platform
Environment=PLAYGROUND_MODEL_GROUP=国外OPENAI分组
ExecStart=/home/sts/semantic-router/bin/router-playground
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
