# Copy to /etc/semantic-router/selector.env and set mode 0600.
# Do not commit the populated file.
MODEL_SELECTOR_SECRET=replace-with-a-long-random-secret

# Optional Official vLLM score-only observer.
MODEL_SELECTOR_OFFICIAL_VLLM_ENABLED=true
MODEL_SELECTOR_OFFICIAL_VLLM_URL=http://127.0.0.1:8080
MODEL_SELECTOR_OFFICIAL_VLLM_TIMEOUT_MS=800

# Persistent, redacted selector state.
MODEL_SELECTOR_HISTORY_FILE=/var/lib/semantic-router/selector_history.jsonl
MODEL_SELECTOR_MODEL_CATALOG_FILE=/var/lib/semantic-router/model_catalog.json
MODEL_SELECTOR_API_KEY_GROUP_FILE=/var/lib/semantic-router/api_key_groups.json
MODEL_SELECTOR_STATUS_MAX_CONCURRENT=32
